### Создание категории
POST http://127.0.0.1:8000/bookings/create/
Content-Type: application/json

{
  "room_id": 3,
  "date_start": "2022-01-31",
  "date_end": "2022-02-14"
}
### Создание комнаты
POST http://127.0.0.1:8000/rooms/create/
Content-Type: application/json

{
  "description": 123,
  "price": 123
}

### Удаление брони
# Ожидаемый ответ сервера: 204 No Content
DELETE http://127.0.0.1:8000/bookings/1/delete/
Accept: application/json


### Полное обновление брони (PUT)
# Обязательно передаются все требуемые поля
# Ожидаемый ответ сервера: 200 OK
PUT http://127.0.0.1:8000/bookings/1/update/
Content-Type: application/json

{
  "date_start": "2026-07-10",
  "date_end": "2026-07-20",
  "room_id": 3
}